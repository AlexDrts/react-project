{
  "name": "afterglow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api": "json-server --watch db.json --port 3001",
    "reset-db": "node -e \"require('fs').copyFileSync('db.seed.json','db.json')\"",
    "start": "concurrently -k -n api,web -c magenta,cyan \"npm:api\" \"npm:dev\"",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@reduxjs/toolkit": "^2.9.0",
    "@tanstack/react-query": "^5.90.0",
    "dexie": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.9.0",
    "styled-components": "^6.1.19"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.2.0",
    "json-server": "0.17.4",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.1.0",
    "vite": "^8.2.0"
  }
}
